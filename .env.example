# Конфигурация окружения для Enterprise Web Crawler
# Скопируйте этот файл в .env и заполните необходимые значения

# =============================================================================
# База данных
# =============================================================================

# PostgreSQL настройки (если используется вместо SQLite)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webcrawler
DB_USER=crawler
DB_PASSWORD=your_secure_password_here

# =============================================================================
# Прокси
# =============================================================================

# Прокси сервер (опционально)
PROXY_ENABLED=false
PROXY_SERVER=proxy.example.com
PROXY_PORT=8080
PROXY_USER=
PROXY_PASSWORD=

# =============================================================================
# Распределённый краулинг
# =============================================================================

# Redis для координации (если используется distributed mode)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# Мониторинг и логирование
# =============================================================================

# Sentry для отслеживания ошибок
SENTRY_ENABLED=false
SENTRY_DSN=

# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# =============================================================================
# API Keys и credentials
# =============================================================================

# User-Agent для краулинга (опционально)
CRAWLER_USER_AGENT="Mozilla/5.0 (compatible; WebCrawler/1.0)"

# =============================================================================
# Безопасность
# =============================================================================

# Secret key для web UI (генерируйте с помощью: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# CORS разрешённые origins для Web API
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Playwright (JavaScript рендеринг)
# =============================================================================

# Playwright browser type: chromium, firefox, webkit
PLAYWRIGHT_BROWSER=chromium

# Headless режим
PLAYWRIGHT_HEADLESS=true

# =============================================================================
# Производительность
# =============================================================================

# Максимум конкурентных запросов
MAX_CONCURRENT_REQUESTS=100

# Rate limit (запросов в секунду)
REQUESTS_PER_SECOND=5

# Максимальный размер файла для загрузки (байты)
MAX_FILE_SIZE=104857600

# =============================================================================
# Логирование
# =============================================================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Формат логов: detailed, json, simple
LOG_FORMAT=detailed

# =============================================================================
# Разработка
# =============================================================================

# Режим разработки
DEBUG=false

# Отключить аутентификацию (только для dev!)
DISABLE_AUTH=false
